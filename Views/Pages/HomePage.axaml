<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LuckyLilliaDesktop.ViewModels"
             xmlns:controls="using:LuckyLilliaDesktop.Controls"
             xmlns:views="using:LuckyLilliaDesktop.Views.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="LuckyLilliaDesktop.Views.Pages.HomePage"
             x:DataType="vm:HomeViewModel">

    <UserControl.Styles>
        <Style Selector=":is(Button).toolbar">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector=":is(Button).toolbar:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector=":is(Button).toolbar:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector=":is(Button).toolbar PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="ToggleButton.toolbar:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrushSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="ToggleButton.toolbar:checked PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="Button.overlay">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="ComboBox.instance">
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundStrong}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- 窄工具条: 实例选择 + 状态 + 操作 -->
        <Border Grid.Row="0"
                Height="44"
                Padding="12,0,8,0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                CornerRadius="12,12,0,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="toolbar"
                            Command="{Binding UpdateCommand}"
                            IsVisible="{Binding HasUpdate}"
                            ToolTip.Tip="{Binding UpdateBannerText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M21 10.12h-6.78l2.74-2.82c-2.73-2.7-7.15-2.8-9.88-.1-2.73 2.71-2.73 7.08 0 9.79s7.15 2.71 9.88 0C18.32 15.65 19 14.08 19 12.1h2c0 1.98-.88 4.55-2.64 6.29-3.51 3.48-9.21 3.48-12.72 0-3.5-3.47-3.53-9.11-.02-12.58s9.14-3.47 12.65 0L21 3v7.12z"
                                      Foreground="{DynamicResource WarningColor}"/>
                            <TextBlock Text="有更新" Foreground="{DynamicResource WarningColor}"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton Classes="toolbar"
                                  IsChecked="{Binding ShowTerminal}"
                                  IsEnabled="{Binding CanShowTerminal}"
                                  ToolTip.Tip="查看当前实例的终端输出，再点一次回到 WebUI">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M20 4H4c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8h16v10zm-2-1h-6v-2h6v2zM7.5 17l-1.41-1.41L8.67 13l-2.59-2.59L7.5 9l4 4-4 4z"/>
                            <TextBlock Text="终端日志"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Classes="toolbar"
                            x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            IsEnabled="{Binding CanRefresh}"
                            ToolTip.Tip="刷新页面">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                            <TextBlock Text="刷新"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar"
                            Command="{Binding StartStopCommand}"
                            IsEnabled="{Binding CanStartStop}"
                            ToolTip.Tip="启动 / 停止当前实例">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z"/>
                            <TextBlock Text="{Binding StartStopText}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" ToolTip.Tip="更多操作">
                        <PathIcon Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="重启当前实例" Command="{Binding RestartCommand}" IsEnabled="{Binding CanRestart}"/>
                                <MenuItem Header="随桌面端启动" Command="{Binding ToggleAutoStartCommand}" IsEnabled="{Binding CanToggleAutoStart}"
                                          ToggleType="CheckBox" IsChecked="{Binding SelectedIsAutoStart, Mode=OneWay}"/>
                                <Separator/>
                                <MenuItem Header="删除当前实例..." Command="{Binding DeleteInstanceCommand}" IsEnabled="{Binding CanDelete}"/>
                                <MenuItem Header="重新扫描实例目录" Command="{Binding RefreshInstancesCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="实例"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <!-- 状态只靠颜色点: 绿 运行中 / 黄 启动或停止中 / 灰 未运行 / 红 失败; 名字右边是端口.
                         列表末尾多一项 "新建实例", 选它不是选实例 (HomeViewModel.PickerSelection) -->
                    <ComboBox Classes="instance"
                              x:Name="InstancePicker"
                              ItemsSource="{Binding PickerItems}"
                              SelectedItem="{Binding PickerSelection}"
                              SelectionChanged="InstancePicker_SelectionChanged"
                              VerticalAlignment="Center">
                        <ComboBox.DataTemplates>
                            <DataTemplate DataType="{x:Type vm:InstanceViewModel}" x:DataType="vm:InstanceViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding BotStatus, Converter={StaticResource StatusToColorConverter}}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PortText}"
                                               IsVisible="{Binding HasPort}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:NewInstanceEntry}" x:DataType="vm:NewInstanceEntry">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Width="10" Height="10" VerticalAlignment="Center"
                                              Foreground="{DynamicResource PrimaryBrush}"
                                              Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                    <TextBlock Text="新建实例..." Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.DataTemplates>
                    </ComboBox>
                    <TextBlock Text="{Binding PageError}"
                               IsVisible="{Binding HasPageError}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerColor}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Panel Grid.Row="1">
            <!-- 原生 HWND 永远盖在 Avalonia 内容上面, 所以显示遮罩时必须隐藏它 -->
            <controls:WebView2Host x:Name="WebView"
                                   Source="{Binding WebUiUrl}"
                                   IsVisible="{Binding ShowWebView}"/>

            <!-- 选中实例的终端输出. 外面套一层是因为 LogPage 自己的 DataContext 换成了 TerminalLog, 可见性要绑在 HomeViewModel 上 -->
            <Border IsVisible="{Binding ShowTerminalView}">
                <views:LogPage DataContext="{Binding TerminalLog}"/>
            </Border>

            <!-- 准备 / 下载 / 实例未运行 / 启动中 / 不支持内嵌 时的遮罩 -->
            <Border IsVisible="{Binding ShowOverlay}"
                    Background="{DynamicResource MainBackground}"
                    CornerRadius="0,0,12,12">
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="32"
                        MinWidth="360"
                        MaxWidth="540"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BoxShadow="0 18 48 0 #18E84D9C">
                    <StackPanel Spacing="16">
                        <controls:LoadingSpinner IsVisible="{Binding ShowSpinner}"
                                                 SpinnerSize="40"
                                                 HorizontalAlignment="Center"/>
                        <PathIcon IsVisible="{Binding ShowErrorIcon}"
                                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                  Width="40" Height="40"
                                  Foreground="{DynamicResource WarningColor}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding OverlayTitle}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding OverlayMessage}"
                                   IsVisible="{Binding HasOverlayMessage}"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <StackPanel Spacing="8" IsVisible="{Binding ShowProgress}">
                            <ProgressBar Value="{Binding DownloadProgress}"
                                         Maximum="100"
                                         Height="8"
                                         Foreground="{DynamicResource PrimaryBrush}"
                                         Background="{DynamicResource BorderColor}"
                                         CornerRadius="4"/>
                            <DockPanel>
                                <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:F0}%}"
                                           DockPanel.Dock="Right"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding DownloadStatus}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </DockPanel>
                        </StackPanel>

                        <WrapPanel HorizontalAlignment="Center" ItemSpacing="10" LineSpacing="10">
                            <Button Classes="ActionButton"
                                    IsVisible="{Binding ShowStartButton}"
                                    Command="{Binding StartStopCommand}"
                                    Content="{Binding StartButtonText}"/>
                            <Button Classes="ActionButton"
                                    IsVisible="{Binding ShowNewInstanceButton}"
                                    Command="{Binding NewInstanceCommand}"
                                    Content="新建实例"/>
                            <Button Classes="overlay"
                                    IsVisible="{Binding ShowCancelDownload}"
                                    Command="{Binding CancelDownloadCommand}"
                                    Background="{DynamicResource DangerColor}"
                                    Foreground="White"
                                    Content="取消下载"/>
                            <Button Classes="ActionButton"
                                    IsVisible="{Binding ShowInstallWebView2}"
                                    Command="{Binding InstallWebView2Command}"
                                    Content="下载安装 WebView2 运行时"/>
                            <Button Classes="overlay"
                                    IsVisible="{Binding ShowOpenInBrowser}"
                                    Command="{Binding OpenInBrowserCommand}"
                                    Content="在浏览器中打开 WebUI"/>
                            <Button Classes="overlay"
                                    IsVisible="{Binding ShowLogsButton}"
                                    Command="{Binding ViewLogsCommand}"
                                    Content="终端日志"/>
                            <Button Classes="overlay"
                                    IsVisible="{Binding ShowLogsButton}"
                                    Command="{Binding OpenLogsCommand}"
                                    Content="打开日志目录"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Panel>
    </Grid>
</UserControl>
