<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LuckyLilliaDesktop.ViewModels"
        xmlns:views="using:LuckyLilliaDesktop.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="LuckyLilliaDesktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://LuckyLilliaDesktop/Assets/Icons/icon.ico"
         Width="960" Height="640"
         MinWidth="880" MinHeight="560"
         SystemDecorations="Full"
         ExtendClientAreaChromeHints="NoChrome"
         ExtendClientAreaTitleBarHeightHint="-1"
         ExtendClientAreaToDecorationsHint="True"
         CanResize="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource MainBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MainBackground" Color="#FFF4FA"/>
                    <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFBFE"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#FDF7FE"/>
                    <SolidColorBrush x:Key="CardBackgroundStrong" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="CardBackgroundSecondary" Color="#FFF0F8"/>
                    <SolidColorBrush x:Key="BorderColor" Color="#F3C4DE"/>
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#E84D9C"/>
                    <SolidColorBrush x:Key="PrimaryBrushSoft" Color="#FFF0F8"/>
                    <SolidColorBrush x:Key="DangerColor" Color="#FF5D72"/>
                    <SolidColorBrush x:Key="SuccessColor" Color="#22C55E"/>
                    <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
                    <SolidColorBrush x:Key="TextPrimary" Color="#3B2434"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#8D6E82"/>
                    <SolidColorBrush x:Key="TitleBarBackground" Color="#FFF9FD"/>
                    <SolidColorBrush x:Key="WindowButtonHover" Color="#10E84D9C"/>
                    <SolidColorBrush x:Key="CloseButtonHover" Color="#FFE6EC"/>
                    <SolidColorBrush x:Key="WindowButtonStroke" Color="#7A6274"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FDF7FE"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#FFF0F8"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#3B2434"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#8D6E82"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#F3C4DE"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MainBackground" Color="#141018"/>
                    <SolidColorBrush x:Key="SidebarBackground" Color="#1A131C"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#201722"/>
                    <SolidColorBrush x:Key="CardBackgroundStrong" Color="#281C2B"/>
                    <SolidColorBrush x:Key="CardBackgroundSecondary" Color="#241926"/>
                    <SolidColorBrush x:Key="BorderColor" Color="#553648"/>
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#F472B6"/>
                    <SolidColorBrush x:Key="PrimaryBrushSoft" Color="#3A2131"/>
                    <SolidColorBrush x:Key="DangerColor" Color="#FB7185"/>
                    <SolidColorBrush x:Key="SuccessColor" Color="#34D399"/>
                    <SolidColorBrush x:Key="WarningColor" Color="#FBBF24"/>
                    <SolidColorBrush x:Key="TextPrimary" Color="#FFF1F8"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#D8B8CA"/>
                    <SolidColorBrush x:Key="TitleBarBackground" Color="#18111A"/>
                    <SolidColorBrush x:Key="WindowButtonHover" Color="#342131"/>
                    <SolidColorBrush x:Key="CloseButtonHover" Color="#4A1F2A"/>
                    <SolidColorBrush x:Key="WindowButtonStroke" Color="#D8B8CA"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#281C2B"/>
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#3A2131"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFF1F8"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#D8B8CA"/>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#553648"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="6,5"/>
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrushSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrushSoft}"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrushSoft}"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>

        <!-- 标题栏里的页面导航标签 -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrushSoft}"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrushSoft}"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem PathIcon">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
        </Style>
        <Style Selector="Button.title-tool">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.title-tool:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.modern-window-button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="Button.modern-window-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource WindowButtonHover}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.modern-window-button.snap-hover">
            <Setter Property="Background" Value="{DynamicResource WindowButtonHover}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.modern-window-button Path">
            <Setter Property="Stroke" Value="{DynamicResource WindowButtonStroke}"/>
            <Setter Property="StrokeThickness" Value="1.35"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="Button.modern-window-button:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="Button.modern-window-button.snap-hover Path">
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="Button.modern-close-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource CloseButtonHover}"/>
        </Style>
        <Style Selector="Button.modern-close-button:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource DangerColor}"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootPanel"
          Background="{DynamicResource MainBackground}"
          ClipToBounds="True">
        <Grid RowDefinitions="54,*">
            <!-- 自定义标题栏: 品牌 | 页面导航 | 主题切换 + 窗口按钮. 桌面端自己不再有侧边栏, 侧边栏留给 WebUI -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,*,Auto"
                  Background="{DynamicResource TitleBarBackground}"
                  PointerPressed="TitleBar_PointerPressed">
                <Border Grid.ColumnSpan="4"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource BorderColor}"/>

                <!-- 左侧品牌区 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            Spacing="10">
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="Bold"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Title}"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 页面导航 -->
                <ListBox Grid.Column="1"
                         Classes="nav"
                         SelectedIndex="{Binding SelectedIndex}"
                         Margin="26,0,0,0"
                         VerticalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem ToolTip.Tip="LLBot 实例与它们的 WebUI">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                            <TextBlock Text="控制面板" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                            <TextBlock Text="关于" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 中间留作拖动区域 -->
                <Border Grid.Column="2" Background="Transparent"/>

                <!-- 右侧: 主题切换 + 窗口按钮 (轻量线条图标) -->
                <Border Grid.Column="3"
                        Margin="0,0,10,0"
                        Padding="0"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button Classes="title-tool"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip.Tip="{Binding ThemeToggleTooltip}">
                            <Panel>
                                <!-- 自动亮暗模式图标 (跟随系统) -->
                                <Viewbox Width="16" Height="16"
                                         IsVisible="{Binding IsSystemTheme}">
                                    <Canvas Width="960" Height="960">
                                        <Path Fill="{DynamicResource TextPrimary}">
                                            <Path.Data>
                                                <PathGeometry FillRule="EvenOdd"
                                                              Figures="M480-28 346-160H160v-186L28-480l132-134v-186h186l134-132 134 132h186v186l132 134-132 134v186H614L480-28Zm0-252q83 0 141.5-58.5T680-480q0-83-58.5-141.5T480-680v400Zm0 140 100-100h140v-140l100-100-100-100v-140H580L480-820 380-720H240v140L140-480l100 100v140h140l100 100Zm0-340Z"/>
                                            </Path.Data>
                                            <Path.RenderTransform>
                                                <TranslateTransform Y="960"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                                <!-- 月亮图标 (深色模式) -->
                                <PathIcon Data="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource TextPrimary}"
                                          IsVisible="{Binding IsDarkTheme}"/>
                                <!-- 太阳图标 (浅色模式) -->
                                <PathIcon Data="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .39-.39.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource TextPrimary}"
                                          IsVisible="{Binding IsLightTheme}"/>
                            </Panel>
                        </Button>
                        <Button Classes="modern-window-button"
                                Click="MinimizeButton_Click"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip.Tip="最小化">
                            <Grid Width="16" Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path Data="M 4 8 L 12 8"/>
                            </Grid>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Classes="modern-window-button"
                                Click="MaximizeButton_Click"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip.Tip="最大化 / 还原">
                            <Grid Width="16" Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path x:Name="MaximizeIconPath"
                                      Data="M 4 4 L 12 4 L 12 12 L 4 12 Z"/>
                                <Path x:Name="RestoreIconPath"
                                      IsVisible="False"
                                      Data="M 6 4 L 12 4 L 12 10 L 10 10 M 4 6 L 10 6 L 10 12 L 4 12 Z"/>
                            </Grid>
                        </Button>
                        <Button Classes="modern-window-button modern-close-button"
                                Click="CloseButton_Click"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip.Tip="关闭">
                            <Grid Width="16" Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path Data="M 4.5 4.5 L 11.5 11.5 M 11.5 4.5 L 4.5 11.5"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 页面区域: 占满整个窗口 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource MainBackground}"
                    CornerRadius="12"
                    Margin="10,8,10,10"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    BoxShadow="0 18 70 0 #18E84D9C">
                <Panel x:Name="PageHost">
                    <views:HomePage x:Name="HomePageView"
                                    IsVisible="True"/>
                    <views:SettingsPage x:Name="SettingsPageView"
                                        IsVisible="False"/>
                    <views:AboutPage x:Name="AboutPageView"
                                     IsVisible="False"/>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</Window>
